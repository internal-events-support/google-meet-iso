{
  "name": "google-meet-iso",
  "version": "1.0.4",
  "description": "Zoom-ISO-style per-participant NDI feeds for Google Meet",
  "main": "dist/main/main.js",
  "scripts": {
    "build:native": "node-gyp rebuild",
    "build:ts": "tsc -p tsconfig.json",
    "build": "npm run build:native && npm run build:ts && npm run build:ui",
    "start": "npm run build:ts && npm run build:ui && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "mock": "npm run build:ts && npm run build:ui && cross-env-shell GMEET_ISO_MOCK=1 electron .",
    "verify:ndi": "node scripts/verify-ndi.js",
    "icons": "electron scripts/build-icons.js",
    "build:ui": "node scripts/build-ui.js",
    "watch:ui": "node scripts/build-ui.js --watch",
    "dist": "npm run build && electron-builder --win --publish never"
  },
  "license": "UNLICENSED",
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "cross-env": "^10.1.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.12",
    "node-gyp": "^11.5.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "mp4-muxer": "^5.2.2",
    "node-addon-api": "^8.9.2",
    "ws": "^8.23.0"
  },
  "private": true,
  "productName": "Google Meet ISO",
  "author": "neriftafu",
  "build": {
    "appId": "com.neriftafu.google-meet-iso",
    "productName": "Google Meet ISO",
    "copyright": "Copyright © 2026 neriftafu",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "static/**/*",
      "build/Release/*.node",
      "package.json"
    ],
    "asarUnpack": [
      "build/Release/*.node"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "static/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "guid": "3ef04187-cea3-5e11-9c21-aff9b6336351",
      "include": "installer/installer.nsh"
    },
    "artifactName": "Google-Meet-ISO-${version}-${os}-${arch}.${ext}"
  }
}
